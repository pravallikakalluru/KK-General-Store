# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://pravalli:123456@localhost:5433/kk_general_stores

# Secret used to sign JWTs - generate a real random value for production,
# e.g. with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Directory (relative to backend/) where uploaded product images are stored
STATIC_DIR=static

# Seed data (used only by seed.py, to create the first store + owner login)
SEED_STORE_NAME=KK General Store
SEED_STORE_CODE=ORD
SEED_STORE_WHATSAPP_NUMBER=919999999999
SEED_OWNER_PHONE=9999999999
SEED_OWNER_PASSWORD=owner12345
