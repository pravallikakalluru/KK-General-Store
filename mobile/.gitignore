# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/*
# Exception: the pre-built web output IS committed, deliberately - Render
# (see /render.yaml at the repo root) serves it directly as a static site
# with no Flutter SDK on the build machine, no server-side build step.
# Rebuild + re-commit this whenever the Flutter app changes
# (`flutter build web --release`, matching the dart-defines the deployed
# backend URL needs - see lib/config/api_config.dart). A blanket `/build/`
# ignore rule can't be re-included by a nested `!` pattern - excluding
# each child of build/ individually (`/build/*`) instead is what makes
# this exception actually take effect.
!/build/web/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
