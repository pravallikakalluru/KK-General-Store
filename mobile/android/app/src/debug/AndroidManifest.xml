<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only (this manifest is merged only into the debug
         variant): allows plain http:// to the local dev backend
         (10.0.2.2 / a LAN IP), which Android blocks by default on API 28+.
         Release builds get no such exception - ApiConfig forces https://
         there, and the app must never reach a production server over
         cleartext HTTP. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
